## pragmas.nogc = true

global bytebox = @record{}

-- ----------------------------------------------------------------------------
-- Console Constants
-- ----------------------------------------------------------------------------

global bytebox.SCREEN_WIDTH     <comptime> = 160
global bytebox.SCREEN_HEIGHT    <comptime> = 120
global bytebox.MEMORY_SIZE      <comptime> = 64 * 1024
global bytebox.FRAMEBUFFER_SIZE <comptime> = (160 * 120) // 2

-- ----------------------------------------------------------------------------
-- Memory Addresses Constants
-- ----------------------------------------------------------------------------

global bytebox.SYSFLAGS_ADDR     <comptime> = 0x0040
global bytebox.SEED_ADDR         <comptime> = 0x0041
global bytebox.GAMENAME_ADDR     <comptime> = 0x0048
global bytebox.WRAM_ADDR         <comptime> = 0xD000
global bytebox.VIDEO_ADDR        <comptime> = 0xD800
global bytebox.COLOR1_ADDR       <comptime> = 0xFF00
global bytebox.COLOR2_ADDR       <comptime> = 0xFF03
global bytebox.COLOR3_ADDR       <comptime> = 0xFF06
global bytebox.COLOR4_ADDR       <comptime> = 0xFF09
global bytebox.COLOR5_ADDR       <comptime> = 0xFF0C
global bytebox.COLOR6_ADDR       <comptime> = 0xFF0F
global bytebox.COLOR7_ADDR       <comptime> = 0xFF12
global bytebox.COLOR8_ADDR       <comptime> = 0xFF15
global bytebox.COLOR9_ADDR       <comptime> = 0xFF18
global bytebox.COLOR10_ADDR      <comptime> = 0xFF1B
global bytebox.COLOR11_ADDR      <comptime> = 0xFF1E
global bytebox.COLOR12_ADDR      <comptime> = 0xFF21
global bytebox.COLOR13_ADDR      <comptime> = 0xFF24
global bytebox.COLOR14_ADDR      <comptime> = 0xFF27
global bytebox.COLOR15_ADDR      <comptime> = 0xFF2A
global bytebox.COLOR16_ADDR      <comptime> = 0xFF2D
global bytebox.GAMEPAD1_ADDR     <comptime> = 0xFF40
global bytebox.GAMEPAD2_ADDR     <comptime> = 0xFF41
global bytebox.SOUND_STATUS_ADDR <comptime> = 0xFF5F
global bytebox.SFX_CH1_ADDR      <comptime> = 0xFF60
global bytebox.SFX_CH2_ADDR      <comptime> = 0xFF64
global bytebox.SFX_CH3_ADDR      <comptime> = 0xFF68
global bytebox.SFX_CH4_ADDR      <comptime> = 0xFF6C
global bytebox.MELODY_ATTR_ADDR  <comptime> = 0xFF7F
global bytebox.MELODY_ADDR       <comptime> = 0xFF80
global bytebox.MELODY_HEAD_ADDR  <comptime> = 0xFFC0
global bytebox.MELODY_TAIL_ADDR  <comptime> = 0xFFC1

-- ----------------------------------------------------------------------------
-- System Flags Bits Constants
-- ----------------------------------------------------------------------------

global bytebox.HALT_FLAG      <comptime> = 0x01
global bytebox.DUMP_WRAM_FLAG <comptime> = 0x02

-- ----------------------------------------------------------------------------
-- Gamepad Buttons Bits Constants
-- ----------------------------------------------------------------------------

global bytebox.BUTTON_2     <comptime> = 0x01
global bytebox.BUTTON_1     <comptime> = 0x02
global bytebox.BUTTON_RIGHT <comptime> = 0x10
global bytebox.BUTTON_DOWN  <comptime> = 0x20
global bytebox.BUTTON_UP    <comptime> = 0x40
global bytebox.BUTTON_LEFT  <comptime> = 0x80

-- ----------------------------------------------------------------------------
-- Imported functions
-- ----------------------------------------------------------------------------

-- Raw host imports (resolved from the wasm "env" namespace)
local function _peek(addr: uint16): uint8
  <cimport, cattribute'import_name("peek")'> end
local function _poke(addr: uint16, value: uint8): void
  <cimport, cattribute'import_name("poke")'> end
local function _spoke(start_addr: uint16, length: uint16, data: *[0]uint8): void
  <cimport, cattribute'import_name("spoke")'> end
local function _trace(str: cstring, len: cint): void
  <cimport, cattribute'import_name("trace")'> end

-- Gets the value of a memory address
function bytebox.peek(addr: uint16): uint8
  return _peek(addr)
end

-- Sets a value into a memory address
function bytebox.poke(addr: uint16, value: uint8): void
  _poke(addr, value)
end

-- Writes multiple bytes into memory
function bytebox.spoke(start_addr: uint16, length: uint16, data: *[0]uint8): void
  _spoke(start_addr, length, data)
end

-- Puts trace information to the console
function bytebox.trace(str: cstring, len: cint): void
  _trace(str, len)
end
